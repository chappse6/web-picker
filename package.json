{
  "name": "web-picker",
  "version": "0.1.0",
  "description": "localhost element picker that bridges browser element picks to MCP coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
