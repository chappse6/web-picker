    "test:mcp": "vitest run test/mcp-stdio.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "jsdom": "^25.0.0",
    "playwright-core": "1.61.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
