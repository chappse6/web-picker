{
  "name": "web-picker",
  "version": "0.1.0",
  "description": "localhost element picker that bridges browser element picks to MCP coding agents",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#web-picker-capture": "./extension/capture.js"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.benchmark.json",
    "benchmark": "npm run build && node dist/benchmark/run.js",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e/chrome-roundtrip.test.ts --testTimeout=60000",
    "test:mcp": "vitest run test/mcp-stdio.test.ts",
    "test:watch": "vitest",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/node": "^20.14.0",
    "jsdom": "^25.0.0",
    "playwright-core": "1.61.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
